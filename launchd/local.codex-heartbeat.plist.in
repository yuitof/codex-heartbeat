<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>__LABEL__</string>
    <key>ProgramArguments</key>
    <array><string>/bin/bash</string><string>__INSTALL__/bin/heartbeat.sh</string><string>check</string></array>
    <key>RunAtLoad</key>__RUN_AT_LOAD__
    <!-- Replaced after each attempt; never a wildcard minute poll. -->
    <key>StartCalendarInterval</key>__CALENDAR__
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>__EXEC_PATH__</string>
        <key>CODEX_HOME</key><string>__AUTH_HOME__</string>
        <key>HEARTBEAT_STATE_DIR</key><string>__STATE__</string>
        <key>HEARTBEAT_LOG_DIR</key><string>__LOGS__</string>
        <key>HEARTBEAT_BASE_DIR</key><string>__INSTALL__</string>
        <key>HEARTBEAT_AGENTS_DIR</key><string>__AGENTS__</string>
        <key>HEARTBEAT_LABEL</key><string>__LABEL__</string>
    </dict>
    <key>StandardOutPath</key><string>__LOGS__/launchd.log</string>
    <key>StandardErrorPath</key><string>__LOGS__/launchd.log</string>
    <key>Umask</key><integer>63</integer>
    <key>ExitTimeOut</key><integer>10</integer>
</dict>
</plist>
